#!/bin/sh

set -eu

# Шаблон systemd-юнита
SERVICE_TEMPLATE="rigger@"
# Хранилище с развернутыми образами контейнеров 
STORAGE_ROOT=/var/lib/rigger

# Перезапуск от root, если скрипт запущен от обычного пользователя
if [ "$(id -u)" -ne 0 ]; then
    exec sudo "$0" "$@"
fi

usage() {
    cat << EOF
Использование: $(basename "$0") <команда> [АРГУМЕНТЫ...]

$(basename "$0") — это легковесный инструмент для управления контейнерами systemd-nspawn 

Команды:
  list                   Вывести список запущенных контейнеров и юнитов
  start <container>      Запустить контейнер
  stop  <container>      Остановить контейнер
  restart <container>    Перезапустить контейнер
  exec <container> [cmd] Выполнить cmd в контейнере (по умолчанию /bin/sh)
  show <container>       Показать статус контейнера и юнита
  log <container>        Вывести логи службы контейнера
  destroy <container>    Уничтожить контейнер (удалить ${STORAGE_ROOT}/<container>)
  help                   Показать эту справку и выйти
EOF
    exit 1
}

# Функция экспорта универсального X11-ключа авторизации в /root/.Xauthority
get_xauth() {
    # 1. Путь для сохранения (по умолчанию пишем в /tmp/container_xauth)
    local container_xauth="${1:-/tmp/container_xauth}"
    
    # Ищем сессию, привязанную к физическому монитору (seat0)
    local SESSION_ID
    SESSION_ID=$(loginctl list-seats 2>/dev/null | grep seat0 | awk '{print $2}' || loginctl list-sessions 2>/dev/null | grep " graphical " | head -n1 | awk '{print $1}')

    # Если через seat0 не нашлось (например, это виртуальная машина), берем первую активную сессию
    if [ -z "$SESSION_ID" ]; then
        SESSION_ID=$(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}' | head -n1)
    fi
    echo "ID найденной сессии: '$SESSION_ID'"

    local USER_NAME
    USER_NAME=$(loginctl show-session "$SESSION_ID" -p Name --value 2>/dev/null)
    echo "Имя пользователя за монитором хоста: '$USER_NAME'"

    # Стандартный канонический путь
    local USER_XAUTH="/home/${USER_NAME}/.Xauthority"

    # Если файла нет по стандартному пути, ищем переменную XAUTHORITY в окружении сессии
    if [ ! -f "$USER_XAUTH" ]; then
        echo "Файл в /home не найден. Опрашиваем окружение сессии через loginctl..."
        for env in $(loginctl show-session "$SESSION_ID" -p Environment --value 2>/dev/null); do
            if [[ "$env" == XAUTHORITY=* ]]; then
                USER_XAUTH="${env#*=}"
            fi
        done
    fi
    echo "Целевой путь к исходному файлу ключей: '$USER_XAUTH'"

    if [ -n "$USER_NAME" ] && [ -f "$USER_XAUTH" ]; then
        # Гарантируем, что целевая папка для файла контейнера существует
        mkdir -p "$(dirname "$container_xauth")"
        
        # Копируем файл, намертво стирая мандатные метки Astra Linux (Parsec)
        cp --no-preserve=mode,ownership,xattr "$USER_XAUTH" "$container_xauth"
        
        # Выставляем права (644 чтобы контейнер гарантированно прочитал)
        chmod 644 "$container_xauth"
        
        echo "Файл успешно создан по пути: $container_xauth"
        echo "Размер созданного файла: $(stat -c %s "$container_xauth") байт"
    else
        echo "Критическая ошибка: Не удалось определить пользователя или найти его .Xauthority"
        return 1
    fi
}
list() {
    machinectl list 2>/dev/null || echo " (нет запущенных)"
    echo ""
    systemctl list-units "${SERVICE_TEMPLATE}*" --no-legend --all --no-pager
}

start() {
    name="$1"
    # Проверка запущен контейнер или нет
    if machinectl show "$name" >/dev/null 2>&1; then
        echo "Контейнер '${name}' уже запущен."
        return 0
    fi

    # Экспорт универсального X11-ключа авторизации (нужно только для запуска графических приложений)
    get_xauth "/run/.Xauthority"

    # Создание дефолтного файла конфигурации
    mkdir -p /etc/systemd/nspawn && cp -n /etc/systemd/nspawn/config.tmpl /etc/systemd/nspawn/${name}.nspawn

    echo "Запуск контейнера '${name}'..."
    systemctl start "${SERVICE_TEMPLATE}${name}.service"
    echo "Готово."
}

stop() {
    name="$1"
    # Проверка запущен контейнер или нет
    if ! machinectl show "$name" >/dev/null 2>&1; then
        echo "Контейнер '${name}' уже остановлен (или не был запущен)."
        return 0
    fi

    echo "Остановка контейнера '${name}'..."
    systemctl stop "${SERVICE_TEMPLATE}${name}.service"
    echo "Готово."
}

restart() {
    name="$1"
    echo "Перезапуск контейнера '${name}'..."
    systemctl restart "${SERVICE_TEMPLATE}${name}.service"
    echo "Готово."
}

execute() {
    name="$1"
    shift

    # Получение PID главного процесса контейнера через machinectl
    pid=$(machinectl show "$name" -p Leader --value 2>/dev/null || true)

    if [ -z "$pid" ] || [ "$pid" -eq 0 ]; then
        echo "Ошибка: Контейнер '$name' не запущен или не найден PID главного процесса." >&2
        exit 1
    fi

    # Если команда не передана, запуск /bin/sh в режиме шелла входа (-l, login shell)
    if [ $# -eq 0 ]; then set -- /bin/sh -l; fi

    # Установка DISPLAY и XAUTHORITY нужна только для запуска графических приложений
    exec nsenter --target "$pid" --mount --uts --ipc --net --pid -- \
        env -i \
        TERM="${TERM:-xterm-256color}" \
        PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
        HOME="/root" \
        DISPLAY=":0" \
        XAUTHORITY="/run/.Xauthority" \
        "$@"
}

show() {
    name="$1"
    systemctl status "${SERVICE_TEMPLATE}${name}.service" --no-pager -n 0 || true
    echo ""
    if machinectl show "$name" >/dev/null 2>&1; then
        machinectl status "$name" --no-pager
    else
        echo "Контейнер '$name' не зарегистрирован или выключен"
    fi
}

destroy() {
    name="$1"
    # Проверяем, запущен ли контейнер в machined
    if machinectl show "$name" >/dev/null 2>&1; then
        echo "Ошибка: Контейнер '$name' сейчас запущен!" >&2
        echo "Остановите его перед удалением: $(basename "$0") stop $name" >&2
        exit 1
    fi

    printf "Вы действительно хотите удалить контейнер? [y/N] "
    read -r response
    if [ "$response" != "y" ] && [ "$response" != "Y" ]; then
        exit 0
    fi

    dir="${STORAGE_ROOT}/$name"
    if [ -d "$dir" ]; then
        echo "Удаление $dir..."
        rm -rf "$dir"
        echo "Контейнер успешно удален"
    else
        echo "Каталог $dir не найден"
    fi
    # Удаление файла конфигурации, если существует
    rm -f /etc/systemd/nspawn/${name}.nspawn
}

log() {
    name="${1:-*}"
    journalctl -u systemd-nspawn@"$name" --no-pager
}

# Проверка минимального количества аргументов
[ $# -lt 1 ] && usage

ACTION="$1"
shift
# Синонимы команд
[ "$ACTION" = "exec" ] && ACTION="execute"
[ "$ACTION" = "help" ] && ACTION="usage"

case "$ACTION" in
    list|start|stop|restart|execute|show|destroy|log|usage) ;;
    *)
        echo "Ошибка: неизвестная команда '$ACTION'" >&2
        usage ;;
esac

# Проверка наличия имени контейнера для всех команд, кроме list
if [ "$ACTION" != "list" ] && [ $# -lt 1 ]; then
    usage
fi

"$ACTION" "$@"
