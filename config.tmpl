[Network]
# Тип сети "Виртуальный Ethernet-канал"
VirtualEthernet=yes
# Тип сети "Подключение к сетевому мосту"
# Bridge=br0

# Проброс портов
# Port=tcp:8080:80
# Port=tcp:4443:443

[Files]
# Проброс конфига DNS в режиме Read-Only
BindReadOnly=/etc/resolv.conf

# Проброс сокета X11 и .Xauthority
Bind=/tmp/.X11-unix
# NB! Вместо проброса файла, почему-то создается пустой каталог
# BindReadOnly=/var/lib/nsbox:/root/.Xauthority

[Exec]
# Вариант загрузки
Boot=no

# Ограничения ресурсов
# LimitMEMORY=2G
# CPUQuota=50%

# Передача переменной DISPLAY (обычно :0)
Environment=DISPLAY=:0

# Программа, запускаемая при старте контейнера
# Parameters=/entrypoint.sh
Parameters=/bin/sleep infinity
