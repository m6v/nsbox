polkit.addRule(function(action, subject) {
    // Доступ к управлению юнитами systemd (контейнерами)
    if (subject.isInGroup("nsbox")) {
        // Разрешение управлением файлами юнитов (revert, enable, disable)
        if (action.id == "org.freedesktop.systemd1.manage-unit-files") {
            return polkit.Result.YES;
        }

        // Разрешение операций над юнитами (start, stop, restart, reload)
        if (action.id == "org.freedesktop.systemd1.manage-units") {
            var unit = action.lookup("unit");
            // Если юнит явно указан — проверяем, что это nsbox@.
            // Если юнит не указан (служебный запрос) — разрешаем.
            if (!unit || unit.indexOf("nsbox@") !== -1) {
                return polkit.Result.YES;
            }
        }
    }
    // Доступ к machinectl (управление машинами)
    if (action.id.indexOf("org.freedesktop.machine1.") === 0 &&
        subject.isInGroup("nsbox")) {
        return polkit.Result.YES;
    }
    // Доступ к importctl (скачивание и импорт образов)
    if (action.id.indexOf("org.freedesktop.import1.") === 0 &&
        subject.isInGroup("nsbox")) {
        return polkit.Result.YES;
    }
});
