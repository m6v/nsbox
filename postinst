#!/bin/sh
set -e

GROUP_NAME="nsbox"
NSBOX_DIR="/var/lib/nsbox"
NFTABLES_DIR="/etc/nftables.d"
NFTABLES_CONF="/etc/nftables.conf"

if [ "$1" = "configure" ]; then
    echo "Выполнение постинсталляционных настроек..."
    /usr/sbin/groupadd -rf "$GROUP_NAME"

    # Настройка владельца и права SGID
    chown -R root:"$GROUP_NAME" "$NSBOX_DIR"
    chmod 2770 "$NSBOX_DIR"
    # Настройка наследования прав для будущих объектов в $NSBOX_DIR,
    # чтобы пользователи из группы $GROUP_NAME могли их удалять
    setfacl -m "g:${GROUP_NAME}:rwx" "$NSBOX_DIR"
    setfacl -d -m "g:${GROUP_NAME}:rwx" "$NSBOX_DIR"
    setfacl -d -m "u::rwx" "$NSBOX_DIR"
    setfacl -d -m "m::rwx" "$NSBOX_DIR"

    # Пока сетевые настройки не трогаем!
    exit 0
    
    # Если главного конфига нет, создать базовый скелет
    if [ ! -f "$NFTABLES_CONF" ]; then
        mkdir -p "$(dirname "$NFTABLES_CONF")"
        echo '#!/usr/sbin/nft -f' > "$NFTABLES_CONF"
        echo 'flush ruleset' >> "$NFTABLES_CONF"
        chmod +x "$NFTABLES_CONF"
    fi

    # Безопасно добавить include
    grep -qxF "include \"$NFTABLES_DIR/*.conf\"" "$NFTABLES_CONF" || \
        echo "include \"$NFTABLES_DIR/*.conf\"" >> "$NFTABLES_CONF"
    
    # Применить правила
    nft -f "$NFTABLES_CONF" 2>/dev/null || true
fi

exit 0
