[Network]
# Тип сети
VirtualEthernet=yes

# Проброс портов
Port=tcp:8080:80
Port=tcp:4443:443
Port=udp:5000:5000

[Files]
# Проброс конфига DNS в режиме Read-Only
BindReadOnly=/etc/resolv.conf

[Exec]
# Вариант загрузки
Boot=no

# Перенесенные ограничения ресурсов
LimitMEMORY=2G
CPUQuota=50%

# Программа, запускаемая при старте контейнера
Parameters=/bin/sleep infinity
# Parameters=/entrypoint.sh
