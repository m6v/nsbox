#!/bin/bash

usage() {
    echo "Очистка верхнего слоя (upperdir) OverlayFS от дубликатов файлов"
    echo
    echo "Использование: $(basename "$0") <upperdir> [<lowerdir>]"
    echo "  upperdir  Путь к верхнему слою"
    echo "  lowerdir  Путь к нижнему слою (по умолчанию: /)"
    exit 1
}

if [ "$1" = "-h" ] || [ "$1" = "--help" ] || [ -z "$1" ]; then
    usage
fi

UPPER_DIR="$1"
LOWER_DIR="${2:-/}"

if [ ! -d "$UPPER_DIR" ]; then
    echo "Ошибка: Директория верхнего слоя '$UPPER_DIR' не существует."
    exit 1
fi

if [ ! -d "$LOWER_DIR" ]; then
    echo "Ошибка: Директория нижнего слоя '$LOWER_DIR' не существует."
    exit 1
fi

# Удаление слешей в конце пути
UPPER_DIR="${UPPER_DIR%/}"
LOWER_DIR="${LOWER_DIR%/}"

removed=0
cnt_checked=0

while read -r upper_file; do
    # Получение относительного пути файла внутри контейнера
    rel_path="${upper_file#$UPPER_DIR}"
    lower_file="$LOWER_DIR$rel_path"
    
    ((checked++))

    # Если файл существует в нижнем слое, побитовая проверка при совпадении размеров
    if [ -f "$lower_file" ]; then
        size_upper=$(stat -c%s "$upper_file")
        size_lower=$(stat -c%s "$lower_file")
        
        if [ "$size_upper" -eq "$size_lower" ]; then
            # Побитовое сравнение
            if cmp -s "$upper_file" "$lower_file"; then
                echo "Удаление дубликата: $rel_path"
                rm -f "$upper_file"
                ((removed++))
            fi
        fi
    fi
done <<< "$(find "$UPPER_DIR" -type f 2>/dev/null)"

echo "Проверено файлов: $checked"
echo "Удалено копий: $removed"
