_nsbox_completion() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    local commands="images load save list start restart stop exec remove status log config"

    case "${prev}" in
        # Команды, для которых нужны только запущенные контейнеры
        stop|restart|exec)
            local running_containers=$(machinectl list --all --no-legend | awk '{print $1}' | grep -v '^\.host$')
            compopt -o nospace 2>/dev/null
            COMPREPLY=( $(compgen -W "${running_containers}" -- "$cur") )
            return 0
            ;;
            
        # Команды, для которых подходят все контейнеры (образы)
        load|log|save|start|remove|status|config)
            local all_containers=$(machinectl list-images --no-legend | awk '{print $1}')
            compopt -o nospace 2>/dev/null
            COMPREPLY=( $(compgen -W "${all_containers}" -- "$cur") )
            return 0
            ;;
            
        list|images)
            return 0
            ;;
    esac

    if [ $COMP_CWORD -eq 1 ]; then
        COMPREPLY=( $(compgen -W "${commands}" -- "$cur") )
        return 0
    fi
}
complete -F _nsbox_completion nsbox
